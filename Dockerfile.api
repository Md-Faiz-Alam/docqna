FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements.txt pyproject.toml README.md ./

RUN python -m pip install --upgrade pip \
    && python -m pip install -r requirements.txt

COPY src ./src

# Editable install is intentional: DocQ&A resolves PROJECT_ROOT from
# src/docqna/constants.py, so this keeps runtime data paths under /app/data.
RUN python -m pip install -e . --no-deps \
    && mkdir -p /app/data/indexes /app/data/metadata /app/logs

EXPOSE 8000

CMD ["uvicorn", "docqna.api.main:app", "--host", "0.0.0.0", "--port", "8000"]

# ============================================
# DocQ&A Environment Configuration
# ============================================

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Public deployment resource protection
MAX_UPLOAD_SIZE_MB=20
MAX_QUESTION_CHARS=2000
MAX_DOCUMENTS_PER_SESSION=3
MAX_ACTIVE_DOCUMENTS=25
MAX_CHUNKS_PER_DOCUMENT=1000
DOCUMENT_RETENTION_HOURS=24

# Per session (or client IP), per API process. 0 disables a limit.
RATE_LIMIT_QA_PER_MINUTE=20
RATE_LIMIT_UPLOADS_PER_MINUTE=10

# LLM provider
LLM_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=phi3:mini
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=320
LLM_TIMEOUT_SECONDS=180

# Storage (defaults to ./data and ./logs in a source checkout)
# DATA_DIR=./data
# LOG_DIR=./logs

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# Retrieval — evaluation-selected values; change only with new evaluation evidence
RRF_K=60
HYBRID_CANDIDATE_POOL_SIZE=10
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu
RERANKER_CANDIDATE_POOL_SIZE=20
ANSWERABILITY_MIN_SCORE=0.0
MAX_CACHED_SESSION_INDEXES=256

# Logging
LOG_LEVEL=INFO

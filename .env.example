# ============================================
# DocQ&A Environment Configuration
# ============================================

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Public upload protection
MAX_UPLOAD_SIZE_MB=20

# LLM provider
LLM_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=phi3:mini

# Logging
LOG_LEVEL=INFO
# ============================================
# DocQ&A Environment Configuration
# ============================================

# Application
APP_ENV=development

# Public deployment resource protection
MAX_UPLOAD_SIZE_MB=20
MAX_QUESTION_CHARS=2000
MAX_DOCUMENTS_PER_SESSION=3
MAX_ACTIVE_DOCUMENTS=25
MAX_CHUNKS_PER_DOCUMENT=1000
DOCUMENT_RETENTION_HOURS=24

# Per session, per API process. 0 disables a limit.
RATE_LIMIT_QA_PER_MINUTE=20
RATE_LIMIT_UPLOADS_PER_MINUTE=10
RATE_LIMIT_FEEDBACK_PER_MINUTE=30
# Each client IP gets this many times the per-session limits, so new session IDs
# cannot get around them. 0 turns the per-IP limit off.
RATE_LIMIT_IP_FACTOR=3
# Proxies in front of the API that append to X-Forwarded-For (Azure Container
# Apps: 1, set in docker/cloud.Dockerfile). 0 ignores the header.
TRUSTED_PROXY_HOPS=0

# Answer feedback retention
FEEDBACK_RETENTION_DAYS=30

# OCR for scanned PDFs (needs Tesseract; included in the Docker image)
OCR_ENABLED=true
OCR_LANGUAGES=eng
MAX_OCR_PAGES=50

# LLM provider: ollama (local, private) or gemini (hosted, fast)
LLM_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=phi3:mini

# Gemini (used only when LLM_PROVIDER=gemini). Put the real key in .env, never here.
# Sends questions and retrieved passages to Google; use Ollama for private documents.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# minimal | low | medium | high, or empty for the model's default
GEMINI_THINKING_LEVEL=minimal

# Generation settings shared by both providers
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=320
LLM_TIMEOUT_SECONDS=180

# Browser origins allowed to call the API (CORS), comma-separated.
# Empty (default) allows no cross-origin browser calls.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://docqna.vercel.app
# Optional regex for extra origins, e.g. Vercel preview deployments:
# CORS_ALLOWED_ORIGIN_REGEX=https://docqna-[a-z0-9-]+\.vercel\.app

# Fictional documents for POST /documents/samples (default: the public benchmark corpus)
# SAMPLE_DOCUMENTS_DIR=./data/evaluation/public/corpus

# Storage (defaults to ./data and ./logs in a source checkout)
# DATA_DIR=./data
# LOG_DIR=./logs

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# Retrieval — evaluation-selected values; change only with new evaluation evidence
RRF_K=60
HYBRID_CANDIDATE_POOL_SIZE=10
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu
RERANKER_CANDIDATE_POOL_SIZE=20
ANSWERABILITY_MIN_SCORE=-10.5
GROUNDING_CHECK_ENABLED=true
# Grounding threshold measured per LLM: GROUNDING_MIN_SCORE for Ollama phi3:mini,
# GEMINI_GROUNDING_MIN_SCORE for Gemini (docs/evaluation.md sections 13-14)
GROUNDING_MIN_SCORE=3.3
GEMINI_GROUNDING_MIN_SCORE=1.5
# Score every answer sentence against the sources it cites and use the weakest
# (true), instead of the whole answer as one claim (false). docs/evaluation.md section 20
GROUNDING_PER_SENTENCE=true
# Prompt-injection defences: remove text addressed to an AI from retrieved passages,
# and refuse answers with links no source contains (docs/evaluation.md section 16)
INJECTION_FILTER_ENABLED=true
# Send unverified draft tokens on /qa/stream before the checks run. Keep false for
# any public deployment: a draft can show text the checks then withdraw.
STREAM_DRAFTS=false
# Answer rules in the LLM's system role, documents in tags with a random name per
# request. Off until measured with experiments/attack_prompt_injection.py.
SEPARATE_PROMPT_ROLES=false
MAX_CACHED_SESSION_INDEXES=256
# Signs answers so a client cannot invent assistant turns in conversation history.
# Leave empty for a random key per process; set it when running several instances.
HISTORY_SIGNING_KEY=

# Logging (file logs rotate at LOG_MAX_BYTES, keeping LOG_BACKUP_COUNT old files)
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=3
